# Normalize line endings: LF in the repo, native on checkout.
# This project must build on both Windows and Linux (project-spec section 7).
* text=auto

# Shell scripts must keep LF even on Windows checkouts.
*.sh text eol=lf

# Windows-only build scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
