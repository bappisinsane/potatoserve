[
  {"id": "tc-01", "category": "tool_call", "name": "get-weather",
   "prompt": "Use the get_weather tool to report the weather for Tokyo in Celsius. After the tool responds, give a one-sentence summary as your final answer.",
   "setup": {}, "inject_errors": [], "max_steps": 5,
   "tools": [{"name": "get_weather", "description": "Get current weather for a city.",
     "parameters": {"type": "object",
       "properties": {"city": {"type": "string"},
                      "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]}},
       "required": ["city", "unit"]}}],
   "checker": {"type": "tool_call_args", "tool": "get_weather",
               "expect": {"city": "Tokyo", "unit": "celsius"}}},

